# Copy only to .test-runs/private/third-party.env. Never commit real values.
# Current Azure Speech adapter reads these fields.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_CLOUD=global
AZURE_VISEME_ENABLED=false

# New local RTC implementation. Keep disabled until local migration/acceptance.
MEETINGS_ENABLED=false
MEETINGS_ACCESS_MONITOR_ENABLED=false
SPEECH_LIP_SYNC_PROVIDER=none
RHUBARB_BIN=
LIVEKIT_DEPLOYMENT=cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Real-time avatar-provider credentials will be defined after adapter selection.
# Do not invent AZURE_AVATAR_* or LIVEAVATAR_* settings here.

# Explicit alternative; default remains azure, no automatic fallback.
SPEECH_PROVIDER=azure
VOLC_SPEECH_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_ZH=
VOLC_TTS_VOICE_EN=

# Overseas alternative: choose SPEECH_PROVIDER=elevenlabs explicitly.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_ZH=
ELEVENLABS_VOICE_ID_EN=

# Reserved planning fields only; no generation adapter consumes these yet.
# Agreed: overseas service, three pilots; provider/budget to decide together.
AVATAR_3D_ENABLED=false
AVATAR_3D_ROUTE=overseas-service
AVATAR_3D_PROVIDER=
AVATAR_3D_PILOT_NAMES=知夏,知行,明悦
AVATAR_3D_STYLE=refined-cartoon-adult
AVATAR_3D_TARGET_FORMAT=
AVATAR_3D_TRIAL_BUDGET_USD=
AVATAR_3D_UPLOAD_APPROVED=false
# Candidate credentials: reserve only, do not fill both or buy a plan yet.
MESHY_API_KEY=
TRIPO_API_KEY=
# Optional console identifier; never used instead of the Bearer API key.
TRIPO_CLIENT_ID=
