# Example process environment. server.cjs does not automatically load this file.
# local:up supplies its isolated database and ports without copying .env files.
DATABASE_URL=postgresql://teamspace_app:teamspace_app_pwd@127.0.0.1:5548/collabspace
COLLAB_PORT=3002
COLLAB_HOST=127.0.0.1
WEB_URL=http://localhost:3000
# Containers: explicitly use COLLAB_HOST=0.0.0.0 and the intended WEB_URL origin.
