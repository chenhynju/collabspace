# 数据库
DATABASE_URL="postgresql://teamspace:teamspace_dev_pwd@127.0.0.1:5434/teamspace?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="7d"

# 应用
APP_PORT=3001
APP_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
COLLAB_WS_URL="ws://localhost:3002/collab"
NODE_ENV=development

# OAuth - Google (留空则不启用 Google 登录)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/oauth/google/callback"

# OAuth - GitHub (留空则不启用 GitHub 登录)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3001/api/v1/auth/oauth/github/callback"

# Stripe (沙盒，留空则用内部模拟计费)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 邮件 (开发态用 console 输出)
EMAIL_FROM="no-reply@teamspace.local"
RESEND_API_KEY=""

# Billing: sandbox only for synthetic development; use stripe for customer billing
BILLING_MODE=sandbox
# Server-owned plan -> recurring Stripe Price mapping (never accept prices from browser)
STRIPE_PRICE_MAP='{"PRO":{"monthly":"price_replace_monthly","yearly":"price_replace_yearly"}}'
# Optional persistent upload directory; production uses /data/uploads volume
UPLOAD_ROOT=""

# PayPal Subscriptions (server REST API; dedicated Sandbox app)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_CURRENCY=USD
PAYPAL_PLAN_MAP='{}'
BILLING_CURRENCY=CNY

# Collaboration assistant: server only; reuse the existing DeepSeek credential.
# Never use NEXT_PUBLIC_ for this key. No automatic model calls or retries.
DEEPSEEK_API_KEY=""

# Azure Speech: cloud/region/key must belong to the same resource.
AZURE_SPEECH_KEY=
# Meetings are local development only until media/revocation acceptance passes.
MEETINGS_ENABLED=false
MEETINGS_ACCESS_MONITOR_ENABLED=false
SPEECH_LIP_SYNC_PROVIDER=none
RHUBARB_BIN=
LIVEKIT_DEPLOYMENT=cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AZURE_SPEECH_REGION=
AZURE_SPEECH_CLOUD=global
VOICE_QUEUE_ENABLED=false

# Enable only after validating the selected voice/locale against the SDK.
AZURE_VISEME_ENABLED=false

# Enable only after the isolated persona migration and maintenance tests pass.
PERSONA_PURGE_ENABLED=false

# Explicit alternative; default remains azure, no automatic fallback.
SPEECH_PROVIDER=azure
VOLC_SPEECH_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_ZH=
VOLC_TTS_VOICE_EN=

# Overseas alternative: choose SPEECH_PROVIDER=elevenlabs explicitly.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_ZH=
ELEVENLABS_VOICE_ID_EN=
