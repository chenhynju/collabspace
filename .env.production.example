# ---- TeamSpace 生产环境变量模板（复制为 .env.production，勿提交真实值）----
POSTGRES_USER=teamspace
POSTGRES_PASSWORD=__生成强密码__
POSTGRES_DB=teamspace
# 应用最小权限账号（首次初始化后由 deploy/init-db.sql 创建）
APP_DB_USER=teamspace_app
APP_DB_PASSWORD=__生成强密码__

REDIS_PASSWORD=__生成强密码__

# 对外地址（HTTPS 域名）
APP_URL=https://api.purelamp.uk
WEB_URL=https://app.purelamp.uk

# JWT 签名密钥：openssl rand -base64 48
JWT_SECRET=__生成__
JWT_ACCESS_EXPIRES_IN=1h

# 邮件（Resend）
EMAIL_PROVIDER=resend
EMAIL_FROM="TeamSpace <no-reply@purelamp.uk>"
RESEND_API_KEY=

# OAuth（可选，留空即关闭）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe 计费（可选，留空走沙盒）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_MODE=sandbox
BILLING_CURRENCY=CNY
STRIPE_PRICE_MAP='{}'
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_PLAN_MAP='{}'
# 沙盒计费 webhook 共享密钥
BILLING_WEBHOOK_SECRET=

# Azure Speech: cloud/region/key must belong to the same resource.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_CLOUD=global
VOICE_QUEUE_ENABLED=false

AZURE_VISEME_ENABLED=false

# Enable only after the isolated persona migration and maintenance tests pass.
PERSONA_PURGE_ENABLED=false
